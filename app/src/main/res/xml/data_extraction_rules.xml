<?xml version="1.0" encoding="utf-8"?>
<!--
  Deliberate full-backup posture (decision confirmed 2026-09-05, re-confirmed with the audit):
  allowBackup stays ON so saved printers (serial + check-code) restore from cloud backup or
  device-to-device transfer onto a new phone — re-pairing every printer by hand after an upgrade
  is worse than LAN-only credentials sitting in the user's own Google backup. Nothing is excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
